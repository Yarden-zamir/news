{
  // Static assets only. The weekly run renders an issue into public/ with the newspaper skill, then deploys.
  // Unknown paths get public/404.html with status 404.
  "name": "news-site",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "preview_urls": false,
  // news is the canonical host. the-riffle carries the name of the paper and serves the same files.
  "routes": [
    { "pattern": "news.yarden-zamir.com", "custom_domain": true },
    { "pattern": "the-riffle.yarden-zamir.com", "custom_domain": true }
  ]
}
